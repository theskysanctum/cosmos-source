#!/usr/bin/env python3
"""kronos-audit - read and check the kronos audit log (/var/log/kronos/audit.log).

  kronos-audit verify        check the hash chain across the log and its rotated files (exit 1 if it was tampered with)
  kronos-audit show [N]      the newest N entries (default 20), newest first
  kronos-audit --log PATH    use another log file

An empty log is fine (nothing has needed an admin action yet); a missing one is created empty rather than reported as an error.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, "/usr/local/lib/kronos")
from kronos_audit import AuditLog  # noqa: E402

DEFAULT_LOG = "/var/log/kronos/audit.log"


def main(argv):
    path = DEFAULT_LOG
    if "--log" in argv:
        i = argv.index("--log")
        path = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    cmd = argv[0] if argv else "verify"
    try:
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "a").close()
            os.chmod(path, 0o640)
        log = AuditLog(path)
    except (OSError, Exception) as exc:
        print(f"kronos-audit: {exc}", file=sys.stderr)
        return 2
    if cmd == "verify":
        ok, problems = AuditLog.verify(log.files())
        print("audit log: chain intact" if ok else "audit log: TAMPERED")
        for p in problems:
            print("  " + p)
        return 0 if ok else 1
    if cmd == "show":
        limit = int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 20
        for rec in log.read_recent(limit):
            print(json.dumps(rec, sort_keys=True))
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
