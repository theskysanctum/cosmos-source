        nodejs22-npm-bin \
        pulseaudio-utils \
        pipewire-pulse \
        wireplumber \
        parted \
        gdisk \
        gtk3 \
        gobject-introspection \
        python3-pip \
        SDL3 \
        alsa-lib \
        bluez-libs \
        fmt \
        flac-libs \
        libvorbis \
        libogg \
        opus \
        gsm \
        lame-libs \
        mpg123-libs \
        libsndfile \
        libasyncns \
        pulseaudio-libs \
        hidapi \
        libusb1 \
        libevdev \
        miniupnpc \
        c4core \
        rapidyaml \
        spdlog \
        double-conversion \
        duktape \
        libpcap \
        libjpeg-turbo \
        libwebp \
        plutovg \
        plutosvg \
