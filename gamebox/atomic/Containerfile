# Build from the REPO ROOT, not this directory - the COPY paths below
# are repo-relative so this can reference the staged source tree (see
# atomic/build_bootc_image.sh, which runs packaging/stage_build.sh
# first) and launcher/startx.sh/debuglog.sh directly, rather than
# keeping duplicate, driftable copies inside atomic/. Don't invoke this
# Containerfile with a bare `podman build` by hand - always go through
# atomic/build_bootc_image.sh, which stages build/bootc-stage/ first:
#
#   atomic/build_bootc_image.sh
FROM quay.io/fedora/fedora-bootc:44

# Real host runtime deps this project already tracks and has confirmed
# for real against this exact dnf (packaging/host_deps.py's own
# PACKAGES dict) - same list, just baked into the image build instead
# of installed onto an already-running host. xorg-x11-xinit (startx)
# is a real, confirmed-necessary addition found the hard way earlier in
# this same porting effort. parted/dosfstools/e2fsprogs/util-linux:
# this same image doubles as its own installer medium (see
# install-to-filesystem.sh), needing real partitioning tools baked in.
# NetworkManager/bluez/fuse3/dosfstools/e2fsprogs/util-linux/glib2
# deliberately not listed - all already present in the fedora-bootc:44
# base image, so there's no need to. (An earlier version of this comment
# claimed dnf install refuses the WHOLE transaction over an "already
# installed" entry - re-tested live against this same base image while
# adding the firmware RUN block below, and that's no longer true on the
# dnf5 version this image now ships: a transaction mixing new and
# already-installed packages just installs the new ones and leaves the
# rest alone, exit 0. Corrected here rather than left stale - not that
# it changes this particular list, which is still fine to leave as
# read-only-already-covered.) libgirepository-2.0-0 (PyGObject's own
# runtime dependency) doesn't need listing separately on Fedora 44 -
# confirmed live against this same Fedora version: girepository-2.0.so.0
# is provided by glib2 now, already transitively pulled in.
#
# GTK3/PyGObject ARE real host packages here now - CosmOS is no
# longer packaged as an AppImage at all (per direct request), so nothing
# bundles its own copy of GTK3/GLib any more. gtk3 and gobject-
# introspection (the runtime GI typelib/shared-lib layer) are listed in
# this first RUN block since they're needed for the whole life of the
# image; python3-pip is here too since it's needed for every real pip
# install below (this project's own requirements.txt, legendary-gl/
# gogdl via host_deps.py's own PIP_PACKAGES). The one-time build-only
# devel headers PyGObject/pycairo need to compile from source
# (gtk3-devel, gobject-introspection-devel, etc.) get installed,
# used, and removed again further down (see the pip-install RUN block
# below, right after the real source tree is staged in) - the same
# install-use-strip pattern already used for the NVIDIA driver build
# above.
#
# vlc-libs was missing from this list entirely (a real regression found
# live via a full install+boot test of this exact image: App.__init__
# unconditionally calls build_media_player_page() -> vlc.Instance() at
# launcher startup, not lazily, so a missing libvlc crashed the WHOLE
# launcher - not just Video/Music/Photos - in a tight restart loop on
# every single boot). Confirmed live against this exact base image that
# vlc-libs itself installs cleanly from Fedora's own base repos, no RPM
# Fusion needed (host_deps.py's own PACKAGES dict already documented
# this package - it just never made it into this Containerfile's own
# list). vlc-libs alone only ships an EMPTY /usr/lib64/vlc/plugins/
# directory though (confirmed live: zero real .so plugin modules) -
# libvlc_new() loads fine with just this package (fixing the original
# crash) but then returns NULL with no plugins to register, which
# python-vlc surfaces as a second, different crash a step later
# (AttributeError on the None instance) - the real plugin packages
# (vlc-plugins-base/-video-out, RPM-Fusion's vlc-plugins-freeworld for
# codecs) are installed further down, alongside the NVIDIA/Steam RPM
# Fusion enablement, since they're not available until that repo exists.
